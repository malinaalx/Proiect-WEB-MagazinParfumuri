    <%# Etapa 5 — Bonus 2) aplicare temă din localStorage înainte de afișare (fără flash) %>
    <script>
        (function () {
            var k = 'mab-bs-theme';
            var v = localStorage.getItem(k);
            var teme = ['lux', 'nocturn', 'menta'];
            var t = teme.indexOf(v) >= 0 ? v : 'lux';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <meta charset="UTF-8">
